options {
  directory "/var/cache/bind";
  //directory "/etc/bind";
  listen-on port 53 { 127.0.0.1; 192.168.1.12; 192.168.1.13; };
  // IPv6 でのリスニングを無効化（または none に設定）
  listen-on-v6 { none; };

  // BINDが上位やルートに問い合わせる際、IPv4（Aレコード）のみを使用するように指定

  allow-query { any; }; // anyなら、どこからでもクエリを受け付ける。
  allow-recursion { any; }; // 再帰検索（上位へのフォワード問い合わせ）を許可

  recursion yes;

  dnssec-validation auto;

  response-policy {
    // レコードの最大TTLを1秒にする設定
    zone "example1.test" max-policy-ttl 1;
  };
}