options {
  directory "/var/cache/bind";
  //directory "/etc/bind";
  listen-on port 53 { 127.0.0.1; 192.168.1.12; };

  allow-query { any; }; // どこからでもクエリを受け付ける
  // allow-query { ! 192.168.1.11; any; }; // attackerの192.168.1.11からはクエリを受け付けない。!で否定の意味。送信元IPアドレスを偽装されていなければ防げる。

  recursion yes; // キャッシュとして持っていないデータはDNSコンテンツサーバに問い合わせる

  dnssec-validation no;
}