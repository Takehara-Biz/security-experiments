options {
  directory "/var/cache/bind";
  //directory "/etc/bind";
  listen-on port 53 { 127.0.0.1; 192.168.1.11; };
  // IPv6 でのリスニングを無効化（または none に設定）
  listen-on-v6 { none; };
  allow-query { any; };
  // ⭐️以下、オリジナルの設定
  // 送信元ポートを固定化して確率を上げる（古いDNSの挙動再現）
  query-source address * port 53000;
  // forward only: 指定したフォワーダーでのみ解決を試み、失敗してもルートサーバーに直接聞きに行かない
  // forward first: （デフォルト）フォワーダーで失敗した場合、自身でルートサーバー等へ聞きに行く
  //forward only;
  // 上位DNSサーバーへの問い合わせタイムアウト（秒）
  resolver-query-timeout 60;
  // （必要に応じて）全体の最大応答待ち時間もあわせて伸ばす場合
  max-retry-time 60;
  // ...既存の設定...
  answer-cookie no;  # ★追加：Cookieの検証と応答への付与を無効化する
  // ⭐️以上、オリジナルの設定

  recursion yes;

  dnssec-validation no;

  # 3. 【重要】未署名ゾーンやローカル検証でのエラーによるServFailを抑止します
  validate-except { "example1.test"; "test"; };

  response-policy {
    // レコードの最大TTLを1秒にする設定
    zone "test" max-policy-ttl 1;
  };
}
